# SentinelPay AI/ML — LOCAL mode
# Uses a local OpenAI-compatible endpoint (e.g. Ollama / vLLM). No hosted keys.
AI_ENVIRONMENT=local
AI_PRIMARY_PROVIDER=qwen
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=qwen2.5
AI_VECTOR_STORE_PROVIDER=chroma
AI_CHROMA_PATH=./.chroma
AI_EMBEDDING_PROVIDER=local
AI_OTEL_ENABLED=false
