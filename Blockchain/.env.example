# SentinelPay Blockchain / Execution subsystem — environment TEMPLATE.
# Copy to `.env` and fill in. NEVER commit real secrets. `.env` is gitignored.
# Signing material lives ONLY in this execution boundary — never in ML / Core / logs / audit.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
BLOCKCHAIN_ENV=testnet
# SIMULATE | TESTNET  (mainnet is intentionally NOT a valid value in V1)
EXECUTION_MODE=SIMULATE
EXECUTION_TIMEOUT_MS=60000

# --- Local Anvil -----------------------------------------------------------
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

# --- Base Sepolia ----------------------------------------------------------
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532
# Circle testnet USDC on Base Sepolia (confirm before use):
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Signer (execution boundary ONLY) --------------------------------------
# A DEDICATED TESTNET private key. Never a production key. Never logged.
# Prefer a secret manager reference in real deployments.
EXECUTION_SIGNER_PRIVATE_KEY=
SIGNING_PROVIDER_REFERENCE=

# --- Smart Account / ERC-4337 (B9) -----------------------------------------
SMART_ACCOUNT_ADDRESS=
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
BUNDLER_URL=

# --- x402 (B10) ------------------------------------------------------------
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=

# --- Attestation (B11) -----------------------------------------------------
ATTESTATION_REGISTRY_ADDRESS=

# --- Mainnet safety --------------------------------------------------------
# Hard gate. Must be explicitly "true" for any mainnet chain to be permitted.
# Left false/blank => any mainnet chain id is rejected before RPC contact.
ALLOW_MAINNET=false
