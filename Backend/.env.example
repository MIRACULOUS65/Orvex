# SentinelPay Backend / Sentinel Core — environment template (placeholders only).
# NEVER put real secrets here. Use .env.local (gitignored) for local secrets.

# ---- Runtime ----
CORE_ENV=local            # local | ci | test | testnet | production
PORT=8090
LOG_LEVEL=info

# ---- Data stores (required from Phase 1) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelpay_core
REDIS_URL=redis://localhost:6379

# ---- Upstream / downstream services ----
AI_SERVICE_URL=http://localhost:8000          # Orvex/ML FastAPI service
EXECUTION_SERVICE_URL=                         # Person 4; mock adapter used until available
INTERNAL_SERVICE_TOKEN=                        # service-to-service auth

# ---- Network / execution safety ----
CORE_NETWORK=base-sepolia
EXECUTION_MODE=SIMULATE                        # SIMULATE | REVIEW_ONLY | TESTNET | AUTONOMOUS
ALLOW_MAINNET=false                            # mainnet must be explicitly enabled

# ---- Observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
